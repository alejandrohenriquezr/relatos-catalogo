# Copiar como .env antes de ejecutar docker compose.
POSTGRES_DB=relatos
POSTGRES_USER=relatos
POSTGRES_PASSWORD=relatos_dev_change_me
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
RUN_SEED=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://relatos:relatos_dev_change_me@db:5432/relatos
# Generar un valor aleatorio distinto para cada entorno. No versionar el .env.
INTERNAL_API_TOKEN=change-this-in-production
